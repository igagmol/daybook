{
  "name": "daybook",
  "private": true,
  "version": "0.0.0",
  "description": "Daybook personal PWA (no build step). Dev tooling only.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:ui": "node tests/e2e/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "bump": "node scripts/bump-version.mjs",
    "serve": "npx --yes http-server -p 8080 -c-1 ."
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "^1.50.0"
  }
}
